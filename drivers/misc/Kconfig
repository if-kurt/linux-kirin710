config MARVELL_CN10K_DPI
	tristate "Octeon CN10K DPI driver"
	depends on PCI && PCI_IOV
	depends on ARCH_THUNDER || (COMPILE_TEST && 64BIT)
	help
	  Enables Octeon CN10K DMA packet interface (DPI) driver which
	  intializes DPI hardware's physical function (PF) device's
	  global configuration and its virtual function (VFs) resource
	  configuration to enable DMA transfers. DPI PF device does not
	  have any data movement functionality, it only serves VF's
	  resource configuration requests.

	  To compile this driver as a module, choose M here: the module
	  will be called mrvl_cn10k_dpi.

config KK_SENSOR_OKUMA
	bool "Kara Kutu: Kirin 710 read-only sensor log (coul V/I, CPU vote)"
	depends on OF && SPMI && MFD_SYSCON
	help
	  Kara Kutu (G34/G35): logs battery voltage/current (hi6555v200 coul, SPMI reads),
	  the PMCTRL CPU frequency vote, battery temperature (the exact 4.9 HKADC request
	  to LPM3 over IPC mailbox-16/0, at most once per 30 s) and SoC temperatures
	  (the 4.9 SMC 0xc5009900), and reboots to the bootloader when a temperature
	  fuse trips. Never writes PMIC or charger registers.

config KK_I2C6_KAPI
	bool "Kara Kutu: Kirin 710 i2c6 gate (read-only CRG/pinmux check)"
	depends on OF && OF_IRQ && I2C_DESIGNWARE_PLATFORM
	help
	  Kara Kutu (G39): reads (never writes) the IOMCU CRG clock gate/reset
	  status and the pinmux of i2c6; only if the bootloader left them usable
	  is the (DT-disabled) designware i2c6 platform device created.

config KK_HI6523_OKU
	bool "Kara Kutu: hi6523 charger read-only logger"
	depends on I2C && OF
	help
	  Kara Kutu (G39, phase 1): reads selected side-effect-free hi6523
	  registers (as 4.9 does) once at probe, then every 30 s after a 60 s
	  gap. Contains no register write path.

config KK_SARJ_SAHTE
	bool "Kara Kutu: FAKE hi6523 + battery model (QEMU only)"
	depends on OF
	help
	  Kara Kutu (G39): in-memory fake charger chip and battery used to test
	  the charge policy in QEMU. Never touches hardware. Never enable in the
	  device image.

config KK_HI6523_DENEY
	bool "Kara Kutu: phase 2 one-shot CHG_EN experiment (sysfs)"
	depends on KK_HI6523_OKU || KK_SARJ_SAHTE
	help
	  Kara Kutu (G40): manually triggered single CHG_EN=1 experiment with
	  read-back, no watchdog feeding, observed for at least 60 s and ended
	  by the driver itself within 3 min. Adds the only hi6523 write path
	  (register 0x90). Not in the phase 1 device image.

config KK_SARJ_POLITIKA
	bool "Kara Kutu: charge policy state machine"
	depends on KK_SARJ_SAHTE || (KK_HI6523_OKU && KK_SENSOR_OKUMA)
	help
	  Kara Kutu (G39): OCV band charge policy. G42 (phase 3): with the hi6523
	  I2C backend (DT "karakutu,sarj-politika") and the chip watchdog layer:
	  writes only 0x90 (CHG_EN), 0xE9 [1:0] (WDT 40 s) and 0xE8 b0 (feed).

config KK_PIL_KORUMA
	bool "Kara Kutu: low battery protection (G-6)"
	depends on OF && CPU_FREQ && KK_SENSOR_OKUMA
	help
	  Kara Kutu (G54, G-6): reads battery V/I through kk_sensor_pil() (coul,
	  read-only SPMI; QEMU: fake battery) and applies three levels: K1 cpufreq
	  ceiling, K2 lowest OPP (+ uevent), K3 one-shot critical action (log only,
	  reboot to a recovery target, or clean poweroff when VBUS is inferred
	  absent). No hardware writes: the ceiling is a freq_qos request.

config KK_PIL_KORUMA_YALNIZ_LOG
	bool "Kara Kutu: low battery protection LOG ONLY (no actions compiled in)"
	depends on KK_PIL_KORUMA
	help
	  Kara Kutu (G55, Beyin: "yalniz log kipi, eylem yok"): levels are computed
	  and logged only. The cpufreq ceiling (freq_qos), the level uevent and the
	  K3 actions (ksys_sync, kernel_restart, orderly_poweroff,
	  kernel_power_off) are NOT compiled in; DT "karakutu,pil-kritik-eylem" is
	  ignored (always "gunluk").

config KK_SARJ_TEST
	bool "Kara Kutu: charge policy TEST hooks (test image only)"
	depends on KK_SARJ_POLITIKA
	help
	  Kara Kutu (G42): kernel command line overrides kk_sarj.test_alt_mv,
	  test_ust_mv, test_pencere_sn, test_dinlenme_sn and the sysfs hook
	  "test_besleme_kes" (stop feeding the chip watchdog without touching
	  CHG_EN). Never in the production image.

config KK_WIFI_M0
	bool "Kara Kutu: Hi1102/SDIO M0 read-only state dump"
	depends on OF
	help
	  Kara Kutu (G42, Wi-Fi slice 2): reads (never writes) the clock gate,
	  reset, pinmux, GPIO and PMIC 32 kHz state needed to bring up the
	  Hi1102 SDIO Wi-Fi. A block's registers are read only after its gate
	  and reset status show it accessible. Not in device images unless
	  approved.

config KK_SDIO_KAPI
	bool "Kara Kutu: Kirin 710 SDIO (dwmmc2 / Hi1102) M1 gate"
	depends on OF && OF_IRQ && OF_ADDRESS && SPMI && MFD_KK_SPMI_SYSCON && MMC_DW_K3
	help
	  Kara Kutu (G45, Wi-Fi M1; G47 S3): off unless the kernel command
	  line has kk_sdio_kapi.ac=1 (then no MMIO/SPMI access at all). When
	  on, probe only READS CRG/pinmux/GPIO/PMIC state and checks
	  preconditions (no write at boot). The write sequence runs only when
	  root writes 1 to the device's sysfs file "baslat" (accepted once per
	  boot; a second trigger is refused): conditional, read-back-verified
	  PMIC 0x3E (see KK_SDIO_KAPI_PMIC_YAZ), CRG (CLKDIV19 b6, PEREN0 b21,
	  PEREN4 b19, PERRSTDIS4 b20), GPIO3_6 (masked DATA) and iomg-mmc1
	  pinmux writes, then the DT-disabled dwmmc2 device is created and the
	  SDIO card enumeration result is logged (no SDIO function driver may
	  be built in). Stops on any unexpected value without MMIO rollback.

config KK_SDIO_KAPI_PMIC_YAZ
	bool "Kara Kutu: SDIO gate may write PMIC 0x3E b0 (approval W1 ONLY)"
	depends on KK_SDIO_KAPI
	help
	  Kara Kutu (G45/G46/G47 W1): compiles the single PMIC write site
	  (0x3E 0x00 -> 0x01, en_32k_bt; only if that write's own read-back
	  does not match, a single rollback 0x3E <- 0x00 from the same site;
	  a stop in a later step leaves 0x3E = 0x01) into kk-sdio-kapi; it is
	  used only with the additional command line flag
	  kk_sdio_kapi.pmic_yaz=1 (default 0) and only after the sysfs
	  trigger. Without the flag, or without this option, the gate only
	  reads 0x3E and stops unless it is already 0x01. W1 approved (G47);
	  default n, only the Faz B image variant enables it.

config KK_HI1102_YUKLE
	bool "Kara Kutu: Hi1102 ROM firmware loader (Wi-Fi M2; sysfs trigger only)"
	depends on KK_SDIO_KAPI
	select CRC32
	select CRYPTO_LIB_SHA256 if !KK_HI1102_YALNIZ_KIP1
	help
	  Kara Kutu (G48, Wi-Fi M2a): minimal loader that talks to the Hi1102
	  boot ROM over the SDIO function the kk-sdio-kapi card check found.
	  Off unless the command line has kk_hi1102_yukle.ac=1; then only two
	  sysfs files appear next to kk-sdio-kapi (no SDIO access at boot, no
	  SDIO function driver is registered). Writing 1 to "yukle" runs the
	  handshake (efuse EC READM + VERSION); writing 2 runs the full download
	  (needs kk_hi1102_yukle.kip_azami=2 and real firmware). Once per boot.
	  All card writes go through one gate limited to a compile time list;
	  the command table is generated at build time from the 4.9 config.
	  G50 (M2c): with the download path built, the embedded images are
	  checked at run time by length, CRC32 and SHA-256 (lib/crypto) before
	  any SDIO access; only the 261632 byte chunk size is accepted.

config KK_HI1102_YALNIZ_KIP1
	bool "Kara Kutu: Hi1102 loader, handshake only (M2b; no download code, no firmware)"
	depends on KK_HI1102_YUKLE
	help
	  Kara Kutu (G49, Wi-Fi M2b): builds only mode 1 of kk-hi1102-yukle
	  (enable fn1, block 512, interrupt mask, F0 0xF0 <- 0, READM efuse EC
	  and VERSION). The download path (SETPM/WRITEM/FILES/QUIT, ready poll),
	  the embedded firmware images and the full command table are NOT
	  compiled; the gate's table has only the READM and VERSION texts.
	  Writing 2 to "yukle" returns -EPERM.

config KK_HI1102_FW_DIR
	string "Directory with the Hi1102 images to embed (cr4_asic.bin, CPU_RAM_SCHED.bin, CPU_RAM_WBS.bin, kk-hi1102-fw-ozet.h)"
	depends on KK_HI1102_YUKLE && !KK_HI1102_YALNIZ_KIP1
	default ""

config KK_HI1102_M3B
	bool "Kara Kutu: Hi1102 M3b (port host layers on top of M3a: cfg80211 STA, passive scan only)"
	depends on KK_SDIO_KAPI && MMC && CFG80211=y && !WILC1000_SDIO && !CFG80211_WEXT && !CFG80211_REQUIRE_SIGNED_REGDB
	select RTC_LIB
	help
	  Kara Kutu (G55, Wi-Fi M3b): after the M3a loader (P-D A0-A9 + A10
	  hcc_enable) reports WLAN_READY, the Huawei host layers (oal/hcc/frw/
	  oam + wal/hmac, built in, no module) take over the bound fn1 with a
	  polled receive, register a wiphy (station only) and wlan0. Single
	  power-up (no GPIO, no mmc_hw_reset, no file firmware), compile-time
	  HCC transmit whitelist (anything else stops), passive scan only
	  (no probe request, connect, mgmt tx, AP, P2P). Requires
	  KK_HI1102_PORT and KK_HI1102_M3A (#error otherwise).

config KK_HI1102_M3C
	bool "Kara Kutu: Hi1102 M3c (connect to one AP: open/WPA2-PSK, passive scan only)"
	depends on KK_HI1102_M3B
	help
	  Kara Kutu (G57 M3c, Beyin framework G57): registers cfg80211
	  connect/disconnect/add_key/del_key/set_default_key on top of M3b,
	  opens the data path behind an L3 whitelist (EAPOL, ARP, DHCP client,
	  ICMP echo on-link), widens the HCC transmit whitelist to the M3c list
	  (anything else -> RED + DUR), pads CONNECT_REQ / STA_SET_EDCA_REG to
	  the 4.9 wire layout, never arms the 120 s STA power-save timer, keeps
	  netdev MAC and MIB StationID identical and masks MAC bytes in OAM logs.

config KK_HI1102_M3C_MAC
	string "Kara Kutu: Hi1102 M3c wlan0 MAC (12 hex, NVE #193 MACWLAN replacement)"
	depends on KK_HI1102_M3C
	default ""
	help
	  Default of hi1102_plat.kk_wlan_mac. Empty: random xx:11:02:.. (4.9
	  error path). The same value is used for wlan0 and the MIB
	  StationID (802.11 addr2).

config KK_HI1102_M3C_QEMU
	bool "Kara Kutu: Hi1102 M3c QEMU-only helpers (record mode, x20 timeouts, fake AP)"
	depends on KK_HI1102_M3C && KK_HI1102_YUKLE_SAHTE
	help
	  Kara Kutu (G56/G57): measurement helpers for the fake Hi1102 only.
	  Record mode (kk_m3c_kayit=1 lets non-listed frames through and logs
	  them), auth/assoc timeouts x20 and the fake AP (auth/assoc, DHCP,
	  ARP, ICMP, WPA2-PSK 4-way handshake). Depends on the fake ROM model,
	  so it can never be enabled in a device image.

config KK_HI1102_M3C_L3_GENIS
	bool "Kara Kutu: Hi1102 M3c wider L3 whitelist (IPv4 unicast TCP/UDP/ICMP), off unless kk_m3c_l3_genis=1"
	depends on KK_HI1102_M3C
	help
	  Kara Kutu (G59-C, Brain approval item): compiles an extension of the
	  M3c data-path L3 whitelist. With boot parameter kk_m3c_l3_genis=1 the
	  filter additionally passes IPv4 unicast TCP, UDP and any ICMP type
	  whose source is wlan0's own address and whose destination is not
	  multicast, broadcast, zero-net or loopback. The default (parameter
	  absent or 0) is the unchanged M3c behaviour: EAPOL, ARP, DHCP client
	  and on-link ICMP echo only. The HCC transmit gate shares the same
	  function, so the last line of defence widens identically.

config KK_HI6523_O1
	bool "Kara Kutu: hi6523 reader also reads STATUS0 (0x06) and 0x8E"
	depends on KK_HI6523_OKU
	help
	  Kara Kutu (G44, approval O1): adds the read-only STATUS0 (ACL/DPM/
	  thermal regulation) and OTG_RESERVE2 (5V VDPM selection) registers
	  to the hi6523 reader list. Both are read by 4.9 in normal operation.

config KK_GUC_TESHIS
	bool "Kara Kutu: read-only power state diagnosis dump"
	depends on OF
	help
	  Kara Kutu (G44): reads (never writes) clock gate, reset and power
	  domain status registers to show which blocks the bootloader left
	  on. A block's own registers are read only after its gate, reset
	  and power status show it accessible. Dumps at probe and once more
	  after a delay. Not in device images unless approved.

config KK_RESET_NEDENI
	bool "Kara Kutu: read-only previous reset reason log (PMIC 0x1E1, SCTRL SCSYSSTAT)"
	depends on OF && SPMI && MFD_SYSCON
	help
	  Kara Kutu (G47, KV7): reads once at boot, never writes, the PMIC
	  HRST_REG13 reboot reason (0x1E1, through the kk-spmi-syscon regmap)
	  and SCTRL SCSYSSTAT (0x004, through the SCTRL syscon regmap), and logs
	  them. Writing SCSYSSTAT resets the SoC; this driver has no write path.

config KK_I2C3_KAPI
	bool "Kara Kutu: Kirin 710 i2c3 gate (G1-G4 read; session-triggered open)"
	depends on OF && OF_IRQ && I2C_DESIGNWARE_PLATFORM
	help
	  Kara Kutu (G47 S1, G48 P1): reads the PERI CRG i2c3 clock gate/reset
	  status, pinmux and pinconf. If all are as expected the (DT-disabled)
	  designware i2c3 device is created at boot without any write.
	  Otherwise nothing is written at boot; writing "ac" to sysfs "kapi"
	  (user space, kk-idle-bekci A0) opens only i2c3's own clock/reset/pinmux
	  bits (4-entry compiled whitelist, each at most once, read back).

config KK_LM36274_KK
	bool "Kara Kutu: LM36274 backlight reader + brightness-0 trigger (production)"
	depends on I2C && OF
	help
	  Kara Kutu (G48 P1, production): reads LM36274 (address 0x11 only)
	  registers at probe without writing; the fault flag register 0x0F is
	  never read. sysfs "kk_arka_isik" accepts only "kapat": 0x04 <- 0 and
	  0x05 <- 0 (compiled whitelist {0x04<-0, 0x05<-0}), each read back.
	  There is no restore path; reboot restores the bootloader value.

config KK_S1_SAHTE
	bool "Kara Kutu: S1 FAKE i2c3/LM36274 adapter and fake bases (QEMU only)"
	depends on I2C && OF
	help
	  Kara Kutu (G47 S1): in-memory fake i2c3 bus with a fake LM36274 at
	  0x11, and acceptance of QEMU RAM addresses in the i2c3 gate. Never
	  enable in a device image.

